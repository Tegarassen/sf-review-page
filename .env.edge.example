# Copy to .env.edge and set via: supabase secrets set --env-file .env.edge
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.
JIRA_SITE=https://sharinpix.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_CLOUD_ID=
JIRA_BOARD_ID=45
JIRA_REVIEW_COLUMN=REVIEW
JIRA_REVIEW_STATUS_IDS=
JIRA_DEV_STATUS=false
# Optional: automatic PR matching against private GitHub repositories.
GH_REPOSITORIES=
GH_READ_TOKEN=
# Optional: scheduler credential (random 32+ characters), also stored in Supabase Vault.
SYNC_SECRET=
# Your GitHub Pages ORIGIN only, no path: https://your-org.github.io
ALLOWED_ORIGIN=
