# Public browser configuration (safe to publish; database policies restrict writes).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional local sync only. Never give these a VITE_ prefix.
# Hosted sync uses the built-in Supabase Edge Function environment instead.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
JIRA_SITE=https://sharinpix.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Required with scoped Jira tokens. Find at your Jira site's /_edge/tenant_info.
JIRA_CLOUD_ID=
JIRA_BOARD_ID=45
JIRA_REVIEW_COLUMN=REVIEW
# Leave empty to resolve the REVIEW column's statuses via the board configuration API.
# If that API is unavailable, specify the verified underlying status IDs, comma-separated.
JIRA_REVIEW_STATUS_IDS=
# Optional: supported GitHub API fallback for PRs whose title/body/branch contains SP-123.
GH_REPOSITORIES=
GH_READ_TOKEN=
# Optional, best-effort INTERNAL Jira Development panel API; not a supported public API.
# Usually requires an unscoped Jira token. Leave false for scoped tokens.
JIRA_DEV_STATUS=false
